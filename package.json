{
  "name": "celebrant-companion",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios --device",
    "android": "expo run:android --device",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:server": "jest --selectProjects server",
    "bundle:check": "expo export --platform ios --platform android --output-dir .expo-export-check",
    "ios:release": "expo run:ios --device --configuration Release",
    "android:release": "expo run:android --device --variant release",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
