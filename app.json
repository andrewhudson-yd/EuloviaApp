{
  "expo": {
    "name": "Eulovia Companion",
    "slug": "celebrant-companion",
    "scheme": "celebrantcompanion",
    "version": "1.0.0",
    "icon": "./assets/eulovia-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F5EF",
    "ios": {
      "icon": "./assets/eulovia-icon.png",
      "bundleIdentifier": "uk.co.dotlogics.eulovia",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The Companion records family meetings, with everyone's agreement, so you can listen instead of taking notes.",
        "NSCameraUsageDescription": "The camera is only used to scan the pairing code shown in your Settings."
      }
    },
    "android": {
      "icon": "./assets/eulovia-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/eulovia-adaptive-icon.png",
        "backgroundColor": "#403C4A"
      },
      "package": "com.example.celebrantcompanion",
      "allowBackup": false,
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5EF",
          "image": "./assets/eulovia-mark.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "The Companion records family meetings, with everyone's agreement, so you can listen instead of taking notes.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is only used to scan the pairing code shown in your Settings.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
